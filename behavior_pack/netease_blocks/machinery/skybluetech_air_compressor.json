                "value": true
            },
            "netease:block_container": {
                "container_size": 4,
                "custom_description": "空气压缩机",
                "screen_name": "AirCompressorUI.main"
            },
            "minecraft:geometry": {
                "identifier": "geometry.skybluetech.air_compressor"
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test",
                    "texture": "skybluetech:air_compressor"
                }
            },
            "tag:piston_denier": {},
            "tag:redstoneflux_accepter": {},
            "tag:redstoneflux_appliance": {},
            "tag:redstoneflux_connectable": {},
            "tag:skybluetech_appliance": {},
            "tag:skybluetech_container": {},
            "tag:skybluetech_machine": {},
            "tag:skybluetech_fluid_container": {}
        },
        "description": {
            "category": "skybluetech",
            "base_block": "netease_container",
            "identifier": "skybluetech:air_compressor",
            "states": {
                "skybluetech:active": [
                    false,
                    true
                ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180.0
                }
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('skybluetech:active')",
