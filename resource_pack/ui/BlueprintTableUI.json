                    ]
                }
            }
        ]
    },
    "grid": {
        "type": "grid",
        "size": [
            "100%",
            "default"
        ],
        "collection_name": "bp_materials",
        "grid_dimensions": [
            5,
            1
        ],
        "grid_item_template": "BlueprintTableUI.cell",
        "grid_rescaling_type": "horizontal",
        "maximum_grid_items": 1024,
        "property_bag": {
            "#maximum_grid_items": 0
        },
        "bindings": [
            {
                "binding_name_override": "#maximum_grid_items",
                "binding_collection_name": "bp_materials",
                "binding_condition": "always_when_visible",
                "binding_type": "collection",
                "binding_name": "#Blueprint.count"
            }
        ]
    },
    "main@common.inventory_screen_common": {
        "$content_size": [
            204,
            94
        ],
        "$has_tabs": false,
        "$has_upgrades": false,
        "$machine_content": "BlueprintTableUI.content",
        "$panel_size": [
            218,
            206
        ],
        "$screen_content": "SkybluePanelLib.machine_screen",
        "$show_led": false,
        "$title_text": "蓝图工作台"
    },
    "namespace": "BlueprintTableUI"
}
