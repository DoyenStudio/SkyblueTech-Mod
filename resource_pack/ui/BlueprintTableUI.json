                        16
                    ]
                }
            },
            {
                "confirm@BlueprintTableUI.action": {
                    "$event": "#Blueprint.confirm",
                    "$label_color": [
                        0.2588,
                        0.2588,
                        0.2588
                    ],
                    "$label_text": "确定",
                    "anchor_from": "top_left",
