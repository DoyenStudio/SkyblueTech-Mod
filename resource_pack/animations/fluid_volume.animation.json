{
    "format_version": "1.8.0",
    "animations": {
        "animation.skybluetech.fluid_model_entity.volume_scale": {
            "loop": true,
            "bones": {
                "bb_main": {
                    "scale": [
                        "query.mod.skybluetech_fluid_volume_width",
                        "query.mod.skybluetech_fluid_volume_height * variable.skybluetech_fluid_fill",
                        "query.mod.skybluetech_fluid_volume_depth"
                    ]
                }
            }
        }
    }
}
