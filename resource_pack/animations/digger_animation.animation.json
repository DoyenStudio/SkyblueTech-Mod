{
	"format_version": "1.8.0",
	"animations": {
		"animation.skybluetech.digger.new": {
			"loop": true
		},
		"animation.skybluetech.digger.rot": {
			"loop": true,
			"animation_length": 1,
			"anim_time_update": "variable.rot_speed=variable.working?query.delta_time:0;variable.anim_rot_speed=variable.anim_rot_speed+(variable.rot_speed-variable.anim_rot_speed)*0.1;return query.anim_time+variable.anim_rot_speed;",
			"bones": {
				"digger": {
					"rotation": {
						"0.0": [
							0,
							0,
							0
						],
						"1": [
							0,
							360,
							0
						]
					}
				}
			}
		},
		"animation.skybluetech.digger.facing": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": [
						"variable.rotation_x",
						0,
						"variable.rotation_z"
					]
				}
			}
		}
	}
}