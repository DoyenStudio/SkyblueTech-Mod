{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.skybluetech.transmit_belt": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                },
                {
                    "fixed_belt": "Material.connected_belt"
                },
                {
                    "back_belt": "Material.connected_belt"
                },
                {
                    "left_belt": "Material.connected_belt_side"
                },
                {
                    "right_belt": "Material.connected_belt_side"
                }
            ],
            "textures": [
                "Texture.default"
            ],
            "part_visibility": [
                {
                    "left_conn": "query.mod.skybluetech_transmit_belt_connect_left"
                },
                {
                    "left_belt": "query.mod.skybluetech_transmit_belt_connect_left"
                },
                {
                    "no_left_conn": "!query.mod.skybluetech_transmit_belt_connect_left"
                },
                {
                    "right_conn": "query.mod.skybluetech_transmit_belt_connect_right"
                },
                {
                    "right_belt": "query.mod.skybluetech_transmit_belt_connect_right"
                },
                {
                    "no_right_conn": "!query.mod.skybluetech_transmit_belt_connect_right"
                },
                {
                    "back_conn": "query.mod.skybluetech_transmit_belt_connect_back || (!query.mod.skybluetech_transmit_belt_connect_left && !query.mod.skybluetech_transmit_belt_connect_right)"
                },
                {
                    "back_belt": "query.mod.skybluetech_transmit_belt_connect_back || (!query.mod.skybluetech_transmit_belt_connect_left && !query.mod.skybluetech_transmit_belt_connect_right)"
                },
                {
                    "no_back_conn": "!(query.mod.skybluetech_transmit_belt_connect_back || (!query.mod.skybluetech_transmit_belt_connect_left && !query.mod.skybluetech_transmit_belt_connect_right))"
                }
            ],
            "ignore_lighting": false
        }
    }
}
