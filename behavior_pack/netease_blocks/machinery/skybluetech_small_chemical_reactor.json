{
    "format_version": "1.21.70",
    "minecraft:block": {
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 3
            },
            "netease:tier": {
                "destroy_special": true,
                "digger": "pickaxe",
                "level": 2
            },
            "netease:block_entity": {
                "tick": true
            },
            "netease:custom_tips": {
                "value": "\n§7乙烯 + 氧气 → 熔融聚乙烯。\n§7需要外部供电，不支持升级。"
            },
            "netease:listen_block_remove": {
                "value": true
            },
            "netease:block_container": {
                "container_size": 1,
                "custom_description": "小型化学反应釜",
                "screen_name": "SmallChemicalReactorUI.main"
            },
            "minecraft:geometry": {
                "identifier": "minecraft:geometry.full_block"
            },
            "tag:piston_denier": {},
            "tag:redstoneflux_accepter": {},
            "tag:redstoneflux_appliance": {},
            "tag:redstoneflux_connectable": {},
            "tag:skybluetech_appliance": {},
            "tag:skybluetech_container": {},
            "tag:skybluetech_machine": {},
            "tag:skybluetech_fluid_container": {}
        },
        "description": {
            "category": "skybluetech",
            "base_block": "netease_container",
            "identifier": "skybluetech:small_chemical_reactor",
            "states": {
                "skybluetech:active": [
                    false,
                    true
                ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180
                }
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('skybluetech:active')",
                "components": {
                    "minecraft:material_instances": {
                        "north": {
                            "texture": "skybluetech:small_chemical_reactor_front_active"
                        },
                        "down": {
                            "texture": "skybluetech:frame_bottom"
                        },
                        "east": {
                            "texture": "skybluetech:frame"
                        },
                        "south": {
                            "texture": "skybluetech:frame"
                        },
                        "up": {
                            "texture": "skybluetech:frame_top"
                        },
                        "west": {
                            "texture": "skybluetech:frame"
                        }
                    },
                    "minecraft:light_emission": 12
                }
            },
            {
                "condition": "!q.block_state('skybluetech:active')",
                "components": {
                    "minecraft:material_instances": {
                        "north": {
                            "texture": "skybluetech:small_chemical_reactor_front"
                        },
                        "down": {
                            "texture": "skybluetech:frame_bottom"
                        },
                        "east": {
                            "texture": "skybluetech:frame"
                        },
                        "south": {
                            "texture": "skybluetech:frame"
                        },
                        "up": {
                            "texture": "skybluetech:frame_top"
                        },
                        "west": {
                            "texture": "skybluetech:frame"
                        }
                    },
                    "minecraft:light_emission": 0
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            }
        ]
    }
}
