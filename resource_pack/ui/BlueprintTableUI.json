{
    "action@common.button": {
        "type": "button",
        "$control_alpha": 1.0,
        "$default_texture": "textures/ui/skybluetech/button_default",
        "$hover_texture": "textures/ui/skybluetech/button_hovered",
        "$label_color": [
            1,
            1,
            1
        ],
        "$label_font_scale_factor": 1.0,
        "$label_font_size": "normal",
        "$label_layer": 3,
        "$label_offset": [
            0,
            0
        ],
        "$pressed_button_name": "$event",
        "$pressed_texture": "textures/ui/skybluetech/button_pressed",
        "$texture_layer": 2,
        "layer": 3,
        "button_mappings": [
            {
                "to_button_id": "$event",
                "from_button_id": "button.menu_select",
                "mapping_type": "pressed"
            },
            {
                "to_button_id": "$event",
                "from_button_id": "button.menu_ok",
                "mapping_type": "pressed"
            }
        ],
        "default_control": "default",
        "hover_control": "hover",
        "pressed_control": "pressed",
        "controls": [
            {
                "default": {
                    "type": "image",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "nineslice_size": 3,
                    "texture": "$default_texture"
                }
            },
            {
                "hover": {
                    "type": "image",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "nineslice_size": 3,
                    "texture": "$hover_texture"
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "nineslice_size": 3,
                    "texture": "$pressed_texture"
                }
            },
            {
                "button_label@netease_editor_template_namespace.button_label": {}
            }
        ]
    },
    "cell": {
        "type": "panel",
        "size": [
            39,
            24
        ],
        "controls": [
            {
                "background": {
                    "type": "image",
                    "size": [
                        38,
                        23
                    ],
                    "layer": 1,
                    "color": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "keep_ratio": false,
                    "texture": "textures/ui/white_background",
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "bp_materials"
                        },
                        {
                            "binding_name_override": "#color",
                            "binding_collection_name": "bp_materials",
                            "binding_type": "collection",
                            "binding_name": "#Blueprint.color"
                        }
                    ]
                }
            },
            {
                "item": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "offset": [
                        0,
                        -3
                    ],
                    "size": [
                        16,
                        16
                    ],
                    "layer": 2,
                    "property_bag": {
                        "#item_id_aux": 131072
                    },
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "bp_materials"
                        },
                        {
                            "binding_name_override": "#item_id_aux",
                            "binding_collection_name": "bp_materials",
                            "binding_type": "collection",
                            "binding_name": "#Blueprint.item"
                        }
                    ]
                }
            },
            {
                "quantity": {
                    "type": "label",
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "layer": 3,
                    "font_scale_factor": 0.7,
                    "shadow": true,
                    "text": "#text",
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "bp_materials"
                        },
                        {
                            "binding_name_override": "#text",
                            "binding_collection_name": "bp_materials",
                            "binding_type": "collection",
                            "binding_name": "#Blueprint.quantity"
                        }
                    ]
                }
            }
        ]
    },
    "content": {
        "type": "panel",
