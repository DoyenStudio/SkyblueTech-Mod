{
    "namespace": "SkyblueMeiCommon",
    "power_hover@mei_common.slot_base": {
        "$binding_name_prefix|default": "mei_ui.recipe.power",
        "controls": [
            {
                "overlay@mei_common.slot_overlay": {
                    "$overlay_btn_control": "mei_common.slot_overlay_button_flat"
                }
            }
        ],
        "size": [
            "100%+0px",
            "100%+0px"
        ]
    },
    "progress_hover@mei_common.slot_base": {
        "$binding_name_prefix|default": "mei_ui.recipe.progress",
        "controls": [
            {
                "overlay@mei_common.slot_overlay": {
                    "$overlay_btn_control": "mei_common.slot_overlay_button_flat"
                }
            }
        ]
    },
    "fluid_slot@mei_common.slot_base": {
        "$binding_name_prefix|default": "mei_ui.recipe.input0",
        "$tank_ticks|default": "textures/ui/skybluetech/tank_ticks_52",
        "size": [
            18,
            54
        ],
        "controls": [
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/white_background",
                    "color": [
                        0.545,
                        0.545,
                        0.545
                    ],
                    "size": [
                        "100%+-2px",
                        "100%+-2px"
                    ],
                    "layer": 1,
                    "keep_ratio": false,
                    "fill": true
                }
            },
            {
                "item": {
                    "type": "panel",
                    "size": [
                        "100%+-2px",
                        "100%+-2px"
                    ],
                    "layer": 1,
                    "visible": "#visible",
                    "property_bag": {
                        "#visible": false
                    },
                    "bindings": [
                        {
                            "binding_name_override": "#visible",
                            "binding_collection_name": "$collection_name",
                            "binding_condition": "always",
                            "binding_type": "collection",
                            "binding_name": "($item_visible_binding_name)"
                        }
                    ],
                    "controls": [
                        {
                            "fluid": {
                                "type": "panel",
                                "size": [
                                    "100%+0px",
                                    "100%+0px"
                                ],
                                "controls": [
                                    {
                                        "img": {
                                            "type": "image",
                                            "anchor_from": "bottom_middle",
                                            "anchor_to": "bottom_middle",
                                            "size": [
                                                "100%+0px",
                                                "0%+0px"
                                            ],
                                            "color": [
                                                1,
                                                1,
                                                1
                                            ],
                                            "texture": "textures/fluid/basic_fluid",
                                            "tiled": true
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "renderer": {
                                "type": "custom",
                                "renderer": "inventory_item_renderer",
                                "layer": 3,
                                "visible": "#visible",
                                "property_bag": {
                                    "#item_id_aux": -10551296
                                },
                                "bindings": [
                                    {
                                        "binding_name_override": "#visible",
                                        "binding_collection_name": "$collection_name",
                                        "binding_condition": "always",
                                        "binding_type": "collection",
                                        "binding_name": "($item_renderer_visible_binding_name)"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "ticks": {
                    "type": "image",
                    "texture": "$tank_ticks",
                    "size": [
                        5,
                        "100%+-2px"
                    ],
                    "anchor_from": "right_middle",
                    "anchor_to": "right_middle",
                    "offset": [
                        -1,
                        0
                    ],
                    "layer": 3,
                    "keep_ratio": false,
                    "fill": true
                }
            },
            {
                "frame": {
                    "type": "image",
                    "texture": "textures/ui/skybluetech/frame_empty_slim",
                    "nineslice_size": 1,
                    "layer": 5,
                    "keep_ratio": false,
                    "fill": true
                }
            },
            {
                "overlay@mei_common.slot_overlay": {}
            }
        ]
    },
    "inputs_9@MachineRecipeLib.inputs_9": {
        "$recipe_item_slot": "mei_common.item_panel",
        "$recipe_fluid_slot": "SkyblueMeiCommon.fluid_slot",
        "$recipe_power_hover": "SkyblueMeiCommon.power_hover",
        "$recipe_progress_hover": "SkyblueMeiCommon.progress_hover"
    },
    "side_slots@MachineRecipeLib.side_slots": {
        "$recipe_item_slot": "mei_common.item_panel",
        "$recipe_fluid_slot": "SkyblueMeiCommon.fluid_slot",
        "$recipe_power_hover": "SkyblueMeiCommon.power_hover",
        "$recipe_progress_hover": "SkyblueMeiCommon.progress_hover"
    },
    "output@MachineRecipeLib.output": {
        "$recipe_item_slot": "mei_common.item_panel",
        "$recipe_fluid_slot": "SkyblueMeiCommon.fluid_slot",
        "$recipe_power_hover": "SkyblueMeiCommon.power_hover",
        "$recipe_progress_hover": "SkyblueMeiCommon.progress_hover"
    },
    "energy_meter@MachineRecipeLib.energy_meter": {
        "$recipe_item_slot": "mei_common.item_panel",
        "$recipe_fluid_slot": "SkyblueMeiCommon.fluid_slot",
        "$recipe_power_hover": "SkyblueMeiCommon.power_hover",
        "$recipe_progress_hover": "SkyblueMeiCommon.progress_hover"
    }
}
