{
    "format_version": "1.21.70",
    "minecraft:block": {
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 3.0
            },
            "netease:tier": {
                "destroy_special": true,
                "digger": "pickaxe",
                "level": 2
            },
            "netease:block_entity": {
                "tick": true
            },
            "netease:custom_tips": {
                "value": "\n§7消耗捕收剂、水和能量，将粗矿分选为预选矿料与精矿滤饼。"
            },
            "netease:listen_block_remove": {
                "value": true
            },
            "netease:block_container": {
                "container_size": 7,
                "custom_description": "浮选机",
                "screen_name": "FlotationMachineUI.main",
                "hopper": {
                    "input": false,
                    "output": false
                }
            },
            "minecraft:geometry": {
                "identifier": "geometry.skybluetech.flotation_machine"
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test",
                    "texture": "skybluetech:flotation_machine"
                }
            },
            "minecraft:item_visual": {
                "geometry": "geometry.skybluetech.flotation_machine",
                "material_instances": {
                    "*": {
                        "render_method": "alpha_test",
                        "texture": "skybluetech:flotation_machine"
                    }
                }
            },
            "minecraft:collision_box": {
                "origin": [-8, 0, -8],
                "size": [16, 16, 16]
            },
            "minecraft:selection_box": {
                "origin": [-8, 0, -8],
                "size": [16, 16, 16]
            },
            "tag:piston_denier": {},
            "tag:redstoneflux_accepter": {},
            "tag:redstoneflux_appliance": {},
            "tag:redstoneflux_connectable": {},
            "tag:skybluetech_appliance": {},
            "tag:skybluetech_container": {},
            "tag:skybluetech_machine": {},
            "tag:skybluetech_fluid_container": {}
        },
        "description": {
            "category": "skybluetech",
            "base_block": "netease_container",
            "identifier": "skybluetech:flotation_machine",
            "states": {
                "skybluetech:active": [false, true]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:cardinal_direction"],
                    "y_rotation_offset": 180.0
                }
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('skybluetech:active')",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "alpha_test",
                            "texture": "skybluetech:flotation_machine_active"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 180, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 0, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, -90, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 90, 0]
                    }
                }
            }
        ]
    }
}
