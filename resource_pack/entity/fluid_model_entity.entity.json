{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "geometry": {
                "default": "geometry.skybluetech.model_entity",
                "volume": "geometry.skybluetech.fluid_volume"
            },
            "scripts": {
                "initialize": [
                    "variable.skybluetech_fluid_fill = 0.0;"
                ],
                "pre_animation": [
                    "variable.skybluetech_fluid_fill = math.lerp(variable.skybluetech_fluid_fill, query.mod.skybluetech_y_scale, 1.0 - math.pow(0.5, math.clamp(query.delta_time, 0.0, 0.1) * 20.0));"
                ],
                "animate": [
                    { "y_scale": "query.mod.skybluetech_fluid_volume_mode < 0.5" },
                    { "volume_scale": "query.mod.skybluetech_fluid_volume_mode >= 0.5" }
                ]
            },
            "materials": {
                "default": "fluid_model",
                "volume": "skybluetech_fluid_volume"
            },
            "identifier": "skybluetech:fluid_model_entity",
            "textures": {
                "default": "textures/models/model_entity_texture",
                "volume": "textures/models/model_entity_texture",
                "volume_dilute_brine": "textures/fluid/baked/skybluetech.dilute_brine/static",
                "volume_saturated_brine": "textures/fluid/baked/skybluetech.saturated_brine/static",
                "volume_water": "textures/blocks/water_still_grey",
                "volume_distilled_water": "textures/fluid/baked/skybluetech.distilled_water/static",
                "volume_water_vapor": "textures/fluid/baked/skybluetech.water_vapor/static",
                "volume_raw_oil": "textures/fluid/baked/skybluetech.raw_oil/static",
                "volume_lubricant": "textures/fluid/baked/skybluetech.lubricant/static",
                "volume_vegetable_oil": "textures/fluid/baked/skybluetech.vegetable_oil/static",
                "volume_liquid_resin": "textures/fluid/baked/skybluetech.liquid_resin/static",
                "volume_molten_rosin": "textures/fluid/baked/skybluetech.molten_rosin/static"
            },
            "animations": {
                "y_scale": "animation.skybluetech.fluid_model_entity.y_scale",
                "volume_scale": "animation.skybluetech.fluid_model_entity.volume_scale"
            },
            "render_controllers": [
                { "controller.render.skybluetech.model_entity": "query.mod.skybluetech_fluid_volume_mode < 0.5" },
                { "controller.render.skybluetech.fluid_volume": "query.mod.skybluetech_fluid_volume_mode >= 0.5" }
            ]
        }
    }
}
