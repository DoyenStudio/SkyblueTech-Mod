{
    "namespace": "SkyblueMeiTemplateAssembler",
    "RECIPES_GRID@mei_recipe_common.recipes_grid": {
        "$recipe_ui_template": "SkyblueMeiTemplateAssembler.recipe"
    },
    "PREVIEW@mei_recipe_common.preview": {
        "$recipe_content_template": "SkyblueMeiTemplateAssembler.content_panel"
    },
    "content_panel@MachineRecipeLib.TemplateAssembler": {
        "$recipe_item_slot": "mei_common.item_panel",
        "$recipe_fluid_slot": "SkyblueMeiCommon.fluid_slot",
        "$recipe_power_hover": "SkyblueMeiCommon.power_hover",
        "$recipe_progress_hover": "SkyblueMeiCommon.progress_hover"
    },
    "recipe@mei_recipe_common.recipe_panel": {
        "size": [
            169,
            72
        ],
        "controls": [
            {
                "wrapper": {
                    "type": "panel",
                    "size": [
                        135,
                        68
                    ],
                    "layer": 1,
                    "controls": [
                        {
                            "content@SkyblueMeiTemplateAssembler.content_panel": {}
                        },
                        {
                            "buttons@mei_recipe_common.buttons_panel_vertical": {
                                "$tree_button_ignored": false
                            }
                        }
                    ]
                }
            }
        ]
    }
}
