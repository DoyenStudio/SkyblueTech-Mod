{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "skybluetech:effluent_outfall",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "atlas.terrain"
            }
        },
        "components": {
            "minecraft:emitter_rate_manual": {"max_particles": 2},
            "minecraft:emitter_lifetime_once": {"active_time": 0.1},
            "minecraft:emitter_initialization": {
                "creation_expression": "variable.fluid_u = 0; variable.fluid_v = 0; variable.fluid_w = 0; variable.fluid_h = 0;"
            },
            "minecraft:emitter_shape_point": {},
            "minecraft:particle_initial_speed": [
                "math.random(-1, 1)", "math.random(-1, 1)", "math.random(-1, 1)"
            ],
            "minecraft:particle_lifetime_expression": {"max_lifetime": "math.random(0.75, 1.25)"},
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [0, 2, 0],
                "linear_drag_coefficient": 2.5
            },
            "minecraft:particle_appearance_billboard": {
                "facing_camera_mode": "lookat_xyz",
                "size": [
                    "0.07 + variable.particle_age * 0.1",
                    "0.07 + variable.particle_age * 0.1"
                ],
                "uv": {
                    "texture_width": 1,
                    "texture_height": 1,
                    "uv": ["variable.fluid_u", "variable.fluid_v"],
                    "uv_size": ["variable.fluid_w", "variable.fluid_h"]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [1, 1, 1, "0.85 * (1 - variable.particle_age / variable.particle_lifetime)"]
            }
        }
    }
