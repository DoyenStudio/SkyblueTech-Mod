{
    "RECIPES_GRID@mei_recipe_common.recipes_grid": {
        "$recipe_ui_template": "SkyblueMeiCompressor.recipe"
    },
    "content_panel": {
        "type": "panel",
        "layer": 1,
        "controls": [
            {
                "power@SkyblueMeiCommon.power_slot": {
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "offset": [
                        4,
                        0
                    ],
                    "size": [
                        16,
                        "100%+-10px"
                    ]
                }
            },
            {
                "body": {
                    "type": "panel",
                    "anchor_from": "right_middle",
                    "anchor_to": "right_middle",
                    "size": [
                        "100%+-20px",
                        "100%+0px"
                    ],
                    "controls": [
                        {
                            "input": {
                                "type": "panel",
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "offset": [
                                    10.0,
                                    0.0
                                ],
                                "size": [
                                    20.0,
                                    60.0
                                ],
                                "layer": 8,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input0",
                                            "anchor_from": "top_middle",
                                            "anchor_to": "top_middle"
                                        }
                                    },
                                    {
                                        "1@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input1"
                                        }
                                    },
                                    {
                                        "2@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input2",
                                            "anchor_from": "bottom_middle",
                                            "anchor_to": "bottom_middle"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "progress@SkybluePanelLib.ProgressBar": {
                                "$bg_image": "textures/ui/compressor_bg",
                                "$mask_image": "textures/ui/compressor_mask",
                                "offset": [
                                    0,
                                    0
                                ],
                                "size": [
                                    36,
                                    20
                                ]
                            }
                        },
                        {
                            "output@SkyblueMeiCommon.output": {
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "offset": [
                                    -4,
                                    0
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "background": {
                    "type": "image",
                    "layer": 1,
                    "texture": "textures/ui/mei/recipe/recipe_bg"
                }
            }
        ]
    },
    "namespace": "SkyblueMeiCompressor",
    "recipe@mei_recipe_common.recipe_panel": {
        "controls": [
            {
                "wrapper": {
                    "type": "panel",
                    "size": [
                        "100%+-34px",
                        "100%+-4px"
                    ],
                    "layer": 1,
                    "controls": [
                        {
                            "content@SkyblueMeiCompressor.content_panel": {}
                        },
                        {
                            "buttons@mei_recipe_common.buttons_panel_vertical": {}
                        }
                    ]
                }
            }
        ],
        "size": [
            174,
            74
        ]
    }
}